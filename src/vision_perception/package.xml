<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vision_perception</name>
  <version>0.0.0</version>
  <description>Vision node with YOLO</description>
  <maintainer email="sulojanrajkumar@gmail.com">sulojan</maintainer>
  <license>Apache-2.0</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>vision_interfaces</depend>
  <exec_depend>python3-opencv</exec_depend>

  <!--
    Python dependencies NOT managed by rosdep/apt:
      ultralytics, torch, torchvision (and pinned numpy<2, opencv-python<4.12)
    These are installed in the workspace virtual environment (.venv) from
    requirements.txt at the workspace root, plus PyTorch from pytorch.org's
    CUDA index. Build with the venv's Python (python -m colcon build, with the
    symlink-install option) so node shebangs point to it. See the README.
  -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
